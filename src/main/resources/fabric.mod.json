		"justfatlard"
	],
	"contact": {
		"homepage": "https://github.com/fatlard1993/conductive-copper",
		"sources": "https://github.com/fatlard1993/conductive-copper",
		"issues": "https://github.com/fatlard1993/conductive-copper/issues"
	},
	"license": "MIT",
	"icon": "assets/conductive_copper/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"justfatlard.conductive_copper.ConductiveCopper"
		]
	},
	"mixins": [
		"conductive_copper.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loaderVersion}",
		"minecraft": "${minecraftDependency}",
		"java": ">=25"
	},
	"suggests": {
		"village-quests-justfatlard": "*",
		"block-tip": "*",
		"mixed-slabs-justfatlard": "*"
	}
}
